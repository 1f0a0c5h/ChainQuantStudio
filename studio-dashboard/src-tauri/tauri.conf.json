{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CHA!N Quant Studio",
  "version": "0.1.0",
  "identifier": "studio.chain.quant",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "CHA!N · QUANT STUDIO",
        "width": 1480,
        "height": 960,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:3000; connect-src 'self' http://127.0.0.1:8765 http://localhost:3000; img-src 'self' data: blob: http://127.0.0.1:8765; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
