{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chain-normalized-spec/v1",
  "title": "CHA!N normalized artifact specification",
  "type": "object",
  "required": ["schema", "artifact", "market", "behavior", "workflow", "safety"],
  "properties": {
    "schema": {"const": "chain-normalized-spec/v1"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "required": ["kind", "name", "stable_id", "version", "horizon", "backtest_required"],
      "properties": {
        "kind": {"enum": ["signal", "strategy"]},
        "name": {"type": "string", "minLength": 1},
        "stable_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "horizon": {"enum": ["short", "medium", "long"]},
        "backtest_required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "market": {"type": "object"},
    "behavior": {"type": "object"},
    "workflow": {"type": "object"},
    "safety": {"type": "object"}
  },
  "additionalProperties": false
}
