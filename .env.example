# CHA!N Quant Studio public framework configuration
# Copy to .env for local use. Never commit .env or credentials.

QSA_LOG_LEVEL=INFO
QSA_STUDIO_HOST=127.0.0.1
QSA_STUDIO_PORT=8765

# Optional outbound advisory notifications. Leave blank when unused.
QSA_TELEGRAM_BOT_TOKEN=
QSA_TELEGRAM_CHAT_ID=

# This public distribution has no bundled Signal Definition or Trading Strategy.
# Live runtime selection and approval are explicit artifact-registry operations;
# strategy-specific symbols, thresholds, and credentials do not belong here.
